# LetResearch web app settings – copy this file to .env and fill in your values.
# Vite builds these into the app, so after changing them on Vercel, redeploy.

# Your Render API URL (no trailing slash). Leave empty during local development:
# the app then uses port 4000 on the same computer (http://<this-host>:4000).
VITE_API_URL=https://letresearch-api.onrender.com

# Optional: a download link to an Android app file (APK) made from this PWA with PWABuilder.
# When set, Android visitors see a "Download Android app (APK)" button next to "Install app".
VITE_ANDROID_APK_URL=
