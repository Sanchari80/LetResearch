# LetResearch API – copy this file to .env for local development.
# On Render, add the same keys under Environment (render.yaml already declares them).

# MongoDB connection string (MongoDB Atlas free tier works well).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/letresearch?retryWrites=true&w=majority

# Long random string used to sign login tokens. Render can generate one for you.
JWT_SECRET=replace-with-a-long-random-string

# Allowed web origins for the browser app, comma separated. Use * to allow all.
# Example: https://letresearch.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Emails that get moderator access (review reported posts), comma separated.
ADMIN_EMAILS=

# Posts with this many community reports are hidden until a moderator reviews them.
REPORT_THRESHOLD=3

# Placeholder price split for paid uploaded papers. Checkout is not enabled yet.
PAPER_PRICE_USD=4.99
PAPER_PLATFORM_FEE_PERCENT=20

# Optional: AI review of photos in posts (blocks memes and non-research images).
# Leave empty to use the built-in rule engine only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: your own web push (notification) keys. When empty, the server creates a key pair on
# first start and keeps it in the database. Create keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional upload limits in megabytes.
MAX_PAPER_MB=20
MAX_IMAGE_MB=8
MAX_VIDEO_MB=40
MAX_CHAT_FILE_MB=15

# Port is provided automatically by Render.
PORT=4000
